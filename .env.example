# MWS_CRM public website-form (Sales & Marketing). Values from
# Documents/Work/MWS_CRM backend/routers/marketing.py and live CRM host.
# POST JSON { name, email, phone, company, message, division: "PR" }
# CRM CORS allows localhost:3000 and primerebar.com. No form token —
# the route is public and IP-rate-limited. Leave the token blank.
NEXT_PUBLIC_MWS_CRM_ENDPOINT=https://crm.primerebar.com/api/marketing/website-form
NEXT_PUBLIC_MWS_CRM_FORM_TOKEN=
